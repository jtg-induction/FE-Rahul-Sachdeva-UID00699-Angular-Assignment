{
  "extends": "stylelint-config-standard-scss",
  "rules": {
    "selector-class-pattern": [
      "^([a-z][a-z0-9]*)(-[a-z0-9]+)*$|^mat-[a-zA-Z0-9_-]+$|^mdc-[a-zA-Z0-9_-]+$",
      {
        "message": "Expected class selector to be kebab-case or a valid MDC/MAT pattern",
        "resolveNestedSelectors": true
      }
    ]
  }
}
